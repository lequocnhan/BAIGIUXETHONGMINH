# --- KỲ BỔ SUNG CHO ĐỒ ÁN ---

# Loại bỏ toàn bộ folder chứa ảnh khuôn mặt (Sửa lại tên folder cho đúng với dự án của ông)
faces/
captured_faces/
detected_faces/

# Loại bỏ các file ảnh lẻ tẻ trong thư mục gốc
*.jpg
*.jpeg
*.png
*.webp

# Loại bỏ folder build của Python (nếu có dùng Flask)
__pycache__/
instance/
.pytest_cache/

# Loại bỏ file Excel nếu ông có dùng tool gỡ pass hay tài liệu cá nhân
*.xlsx
*.xls
*.csv